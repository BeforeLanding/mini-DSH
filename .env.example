DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

MINI_DSH_MODEL=deepseek/deepseek-v4-flash
MINI_DSH_PROFILE=coding
# Optional workspace-relative context directory; does not change file/Bash cwd.
# MINI_DSH_PROJECT_DIRECTORY=.

# Paid evaluation entries (`pnpm eval:screening`, `pnpm eval:sequence`). They call the real model and are
# billed. `--plan-only` prints what a batch would run without creating directories or sending requests.
# Overrides the model for evaluations only, so a screening batch can be pinned while MINI_DSH_MODEL moves.
# MINI_DSH_EVAL_MODEL=deepseek/deepseek-v4-flash
# Evidence directory for one batch; it must not already exist, so every run needs a fresh directory.
# MINI_DSH_EVAL_EVIDENCE_DIR=.eval-evidence/screening-full
# Model window in tokens. Required for a non-official DEEPSEEK_BASE_URL; the official endpoint defaults to 1000000.
# MINI_DSH_EVAL_CONTEXT_WINDOW=1000000
