DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

MINI_DSH_MODEL=deepseek/deepseek-v4-flash
MINI_DSH_PROFILE=coding
# Prompt prefix: live (default) or frozen. Frozen project rules refresh only after restarting the CLI.
# MINI_DSH_CONTEXT_LAYOUT=live
# MINI_DSH_RUNTIME_TIME_MODE=frozen
# Positive safe integer; default tool result preview is 16384 bytes.
# MINI_DSH_TOOL_PREVIEW_BYTES=16384
# Optional workspace-relative context directory; does not change file/Bash cwd.
# MINI_DSH_PROJECT_DIRECTORY=.
