DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

MINI_DSH_MODEL=deepseek/deepseek-v4-flash
MINI_DSH_PROFILE=coding
# Prompt prefix: live (default) or frozen. Frozen project rules refresh only after restarting the CLI.
# MINI_DSH_CONTEXT_LAYOUT=live
# MINI_DSH_RUNTIME_TIME_MODE=frozen
# Positive safe integer; default tool result preview is 16384 bytes.
# MINI_DSH_TOOL_PREVIEW_BYTES=16384
# Optional workspace-relative context directory; does not change file/Bash cwd.
# MINI_DSH_PROJECT_DIRECTORY=.

# Optional project memory: off (default), recall, or assist (candidate proposals; human approval).
# MINI_DSH_MEMORY=assist
# MINI_DSH_MEMORY_DIR=C:/Users/you/.mini-dsh/memory
# Cross-worktree sharing requires an explicit 64-hex project id shown by /memory review.
# MINI_DSH_MEMORY_PROJECT_ID=
# MINI_DSH_MEMORY_LIMITS={"maxItems":5,"maxTokens":2048,"maxBytes":8192}
# Optional read-only delegation. Main agent is the only workspace writer.
# MINI_DSH_DELEGATION=read-only
# MINI_DSH_TEAM_DIR=C:/Users/you/.mini-dsh/teams
# MINI_DSH_TEAM_LIMITS={"maxConcurrent":2,"maxChildrenPerTask":4}
# Shared across main/child/summary/retry; token estimates are not a provider billing hard cap.
# MINI_DSH_TASK_GROUP_BUDGET={"maxModelRequests":64,"maxToolCalls":128,"maxTotalTokens":2000000,"rootTokenFloor":1000000,"rootRequestFloor":32,"maxWallDurationMs":900000}

# Paid evaluation entries (`pnpm eval:screening`, `pnpm eval:sequence`). They call the real model and are
# billed. `--plan-only` prints what a batch would run without creating directories or sending requests.
# Overrides the model for evaluations only, so a screening batch can be pinned while MINI_DSH_MODEL moves.
# MINI_DSH_EVAL_MODEL=deepseek/deepseek-v4-flash
# Evidence directory for one batch; it must not already exist, so every run needs a fresh directory.
# MINI_DSH_EVAL_EVIDENCE_DIR=.eval-evidence/screening-full
# Model window in tokens. Required for a non-official DEEPSEEK_BASE_URL; the official endpoint defaults to 1000000.
# MINI_DSH_EVAL_CONTEXT_WINDOW=1000000
