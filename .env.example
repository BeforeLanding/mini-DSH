# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Default model. Format: provider/model
MINI_DSH_MODEL=deepseek/deepseek-v4-flash

# Directory the agent works in; defaults to the process cwd.
# MINI_DSH_WORKSPACE=/absolute/path/to/project
# MINI_DSH_AUTO_APPROVE=1

# Optional Context7 MCP key. The host still starts if Context7 is unreachable.
# CONTEXT7_API_KEY=

# JSON budget overrides. Custom endpoints require explicit contextWindowTokens.
# MINI_DSH_BUDGET={"maxModelRequests":64,"maxToolCalls":128,"maxActiveDurationMs":600000,"maxTotalTokens":2000000}
# MINI_DSH_SESSION_DIR=/absolute/path/to/session-storage
# Resume a previously printed session id in the same workspace:
# MINI_DSH_SESSION_ID=00000000-0000-0000-0000-000000000000
