DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# DeepSeek thinking mode: enabled (default) or disabled. Disabled requests return no reasoning content.
# DEEPSEEK_THINKING=enabled

MINI_DSH_MODEL=deepseek/deepseek-v4-flash
MINI_DSH_PROFILE=coding
# Prompt prefix: live (default) or frozen. Frozen project rules refresh only after restarting the CLI.
# MINI_DSH_CONTEXT_LAYOUT=live
# MINI_DSH_RUNTIME_TIME_MODE=frozen
# Positive safe integer; default tool result preview is 16384 bytes.
# MINI_DSH_TOOL_PREVIEW_BYTES=16384
# Optional workspace-relative context directory; does not change file/Bash cwd.
# MINI_DSH_PROJECT_DIRECTORY=.

# Optional read-only delegation (default off). The main agent remains the only workspace writer.
# MINI_DSH_DELEGATION=read-only
# MINI_DSH_TEAM_DIR=C:/Users/you/.mini-dsh/teams
# MINI_DSH_TEAM_LIMITS={"maxConcurrent":2,"maxChildrenPerTask":4}
# Shared across main/child/summary/retry; token estimates are not a provider billing hard cap.
# MINI_DSH_TASK_GROUP_BUDGET={"maxModelRequests":64,"maxToolCalls":128,"maxTotalTokens":2000000,"rootTokenFloor":1000000,"rootRequestFloor":32,"maxWallDurationMs":900000}
