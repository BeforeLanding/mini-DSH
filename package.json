{
  "name": "@beforelanding/mini-dsh",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A minimal, reproducible coding-agent harness with event sourcing, context budgets, and offline evidence.",
  "repository": {
    "type": "git",
    "url": "https://github.com/BeforeLanding/mini-DSH.git"
  },
  "bin": {
    "mini-dsh": "dist/src/index.js"
  },
  "files": [
    "dist/src/",
    "dist/plugins.config.js"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "prepack": "node scripts/build.js",
    "start": "pnpm build && node dist/src/index.js",
    "test": "pnpm build && node --test dist/test/*.test.js",
    "fixtures:check": "pnpm build && node dist/scripts/check-coding-fixtures.js",
    "eval:offline": "pnpm build && node dist/scripts/eval-offline.js",
    "bench:components": "pnpm build && node scripts/benchmark-components.mjs --compare docs/samples/components-baseline.json",
    "eval:screening": "pnpm build && node dist/scripts/eval-screening.js",
    "eval:sequence": "pnpm build && node dist/scripts/eval-screening.js --phase sequence",
    "eval:estimate": "pnpm build && node dist/scripts/eval-estimate.js",
    "token:error": "pnpm build && node dist/scripts/report-token-error.js",
    "evidence:export": "pnpm build && node dist/scripts/export-public-evidence.js",
    "evidence:recompute": "pnpm build && node dist/scripts/recompute-report.js",
    "swebench:preregister": "pnpm build && node dist/scripts/swebench/preregister.js",
    "swebench:run": "pnpm build && node dist/scripts/swebench/run.js",
    "swebench:report": "pnpm build && node dist/scripts/swebench/report.js",
    "swebench:external-probe": "pnpm build && node dist/scripts/swebench/external-probe.js",
    "eval:v2": "pnpm build && node dist/scripts/eval-v2.js",
    "eval:v2-freeze": "pnpm build && node dist/scripts/eval-v2-freeze.js",
    "eval:v2-report": "pnpm build && node dist/scripts/eval-v2-report.js",
    "eval:v2-run": "pnpm build && node dist/scripts/eval-v2-run.js",
    "eval:v2-compare": "pnpm build && node dist/scripts/eval-v2-compare.js",
    "smoke:freeze": "pnpm build && node dist/scripts/smoke-freeze.js",
    "smoke:run": "pnpm build && node dist/scripts/smoke-run.js",
    "eval:ledger-target": "pnpm build && node dist/scripts/eval-ledger-target.js",
    "eval:ledger-verdict": "pnpm build && node dist/scripts/eval-ledger-verdict.js",
    "eval:ablation-report": "pnpm build && node dist/scripts/eval-ablation-report.js",
    "eval:factor-precheck": "pnpm build && node dist/scripts/eval-factor-precheck.js",
    "demo:fix": "pnpm build && node dist/scripts/demo-fix.js",
    "demo:resume": "pnpm build && node dist/scripts/demo-resume.js",
    "demo:unknown": "pnpm build && node dist/scripts/demo-unknown.js",
    "demo:compact": "pnpm build && node dist/scripts/demo-compact.js",
    "demo:memory": "pnpm build && node dist/scripts/demo-memory.js",
    "demo:team": "pnpm build && node dist/scripts/demo-team.js",
    "eval:memory-team": "pnpm build && node dist/scripts/eval-memory-team.js",
    "session:lock": "pnpm build && node dist/scripts/session-lock.js",
    "check": "pnpm build && node scripts/check-syntax.js",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "node scripts/build.js"
  },
  "keywords": [
    "dsh"
  ],
  "author": "jeffery jia",
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-mcp-client": "0.1.1-rc.2",
    "cross-spawn": "7.0.6",
    "dotenv": "17.4.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@types/node": "^24.19.0",
    "typescript": "7.0.2"
  }
}
